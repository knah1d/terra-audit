# Copy to .env for local Docker use (never commit the real file — .env is
# git-ignored); on Railway, set these as service variables in its
# dashboard instead of a file. Consumed by backend/config.py,
# src/data_engine.py, and src/database.py; docker-compose.yml's backend
# service loads this whole file via `env_file: .env`.

# Required for the Sentinel-1/SAR pipeline (signal-analytics endpoints).
# Without it, the API still starts — signal-run endpoints 503 instead of
# crashing (see backend/main.py's lifespan).
EE_PROJECT=your-gcp-project-id

# Required in any deployment without a locally cached `earthengine
# authenticate` login (e.g. Railway) — paste the full service-account
# JSON key as a single-line string. The service account must be
# registered for Earth Engine access on EE_PROJECT.
# EE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Required in any real deployment — without it the backend falls back to
# an insecure, well-known dev-only default and logs a loud warning.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Required once the frontend is deployed anywhere but localhost:3000 — a
# regex (not a fixed list) because Vercel gives every branch/PR its own
# preview subdomain. Example covering a prod domain + all its previews:
# ALLOWED_ORIGIN_REGEX=https://terra-audit\.vercel\.app|https://terra-audit-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=http://localhost:3000

# Optional — omit to use the default local SQLite file
# (persisted via docker-compose's backend_data volume). On Railway,
# attach the Postgres plugin instead and use the DATABASE_URL it injects.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Optional — self-serve signup OTP email, sent via Brevo's HTTPS API
# (not SMTP: Railway confirmed to silently drop outbound SMTP on both
# ports 587 and 465). Without BREVO_API_KEY, OTPs are logged to stdout
# instead of emailed (fine for internal/trusted deployments only).
# BREVO_API_KEY=
# EMAIL_FROM=no-reply@yourdomain.com  # must match a sender verified in Brevo
#                                      # (single-sender verification works fine — no domain required)
# OTP_EXPIRE_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60

# AI workspace: set both on API and worker. Choose a model that supports
# the Responses API and strict structured outputs. No default model/key.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AI_PROVIDER_REQUESTS_PER_DAY=100

# Account invitation/recovery links. Recovery uses the Brevo settings above.
# FRONTEND_PUBLIC_URL=https://your-frontend.example

# Shared attachments AND managed model artifacts. Local is suitable only
# when API and worker share the SAME persistent directory/volume.
# STORAGE_BACKEND=local
# ATTACHMENTS_DIR=/app/data/attachments
# For separate hosts (e.g. separate Railway services), configure private S3:
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_PREFIX=terra-audit
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# AWS_DEFAULT_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
