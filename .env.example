# Copy to .env for local Docker use (never commit the real file — .env is
# git-ignored); on Railway, set these as service variables in its
# dashboard instead of a file. Consumed by backend/config.py,
# src/data_engine.py, and src/database.py; docker-compose.yml's backend
# service loads this whole file via `env_file: .env`.

# Required for the Sentinel-1/SAR pipeline (signal-analytics endpoints).
# Without it, the API still starts — signal-run endpoints 503 instead of
# crashing (see backend/main.py's lifespan).
EE_PROJECT=your-gcp-project-id

# Required in any real deployment — without it the backend falls back to
# an insecure, well-known dev-only default and logs a loud warning.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Required once the frontend is deployed anywhere but localhost:3000 — a
# regex (not a fixed list) because Vercel gives every branch/PR its own
# preview subdomain. Example covering a prod domain + all its previews:
# ALLOWED_ORIGIN_REGEX=https://terra-audit\.vercel\.app|https://terra-audit-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=http://localhost:3000

# Optional — omit to use the default local SQLite file
# (persisted via docker-compose's backend_data volume). On Railway,
# attach the Postgres plugin instead and use the DATABASE_URL it injects.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Optional — self-serve signup OTP email, sent via Resend's HTTPS API
# (not SMTP: Railway confirmed to silently drop outbound SMTP on both
# ports 587 and 465). Without RESEND_API_KEY, OTPs are logged to stdout
# instead of emailed (fine for internal/trusted deployments only).
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@yourdomain.com  # must be on a domain verified in Resend
# OTP_EXPIRE_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
